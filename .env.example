# Ayar dosyası örneği. Gerçek değerler bu dosyaya YAZILMAZ (bu dosya depodadır).
#
# Kullanım (iki yoldan biri):
#   1) Ortam değişkeni (önceliklidir):
#        setx HARITA_API_ANAHTARI "anahtariniz"      (Windows; yeni açılan pencerelerde geçerli)
#   2) .env dosyası: bu dosyayı veri klasörüne ".env" adıyla kopyalayıp değerleri girin:
#        C:\Users\<kullanıcı>\AfetLojistik\.env
#      Veri klasörü hiçbir deponun içinde değildir; anahtar yanlışlıkla commit'lenemez.
#      (Proje klasörüne .env konsa bile .gitignore onu depoya almaz.)
#
# Okuma kodu: backend/config.py -> ayar(), env_dosyasi_oku()  (ek paket gerekmez)

# Boş bırakılırsa: C:\Users\<kullanıcı>\AfetLojistik\afet_lojistik.db
AFET_DB_YOLU=

# Hafta 9 - Harita/rota: OpenRouteService API anahtarı (ücretsiz hesap: openrouteservice.org)
# Boşsa uygulama çalışır, mesafeler kuş uçuşu tahmin olarak gösterilir.
HARITA_API_ANAHTARI=
# Servis bu kadar saniyede yanıt vermezse tahmine geçilir (boşsa 6)
HARITA_ZAMAN_ASIMI_SN=
# İstemcinin dakikada en fazla göndereceği istek (boşsa 30; servis sınırı 40)
HARITA_DAKIKALIK_ISTEK=

# Hafta 10 - Yapay zekâ bileşeni
LLM_API_ANAHTARI=
